<!doctype html>
<html class="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline' https://cdnjs.cloudflare.com https://esm.sh https://cdn.jsdelivr.net https://unpkg.com; style-src 'unsafe-inline'; img-src data: blob: https://cdnjs.cloudflare.com https://esm.sh https://cdn.jsdelivr.net https://unpkg.com; font-src data: https://cdnjs.cloudflare.com https://esm.sh https://cdn.jsdelivr.net https://unpkg.com; connect-src https://cdnjs.cloudflare.com https://esm.sh https://cdn.jsdelivr.net https://unpkg.com; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
<style>
:root {
  --color-background-primary: #ffffff;
  --color-background-secondary: #f2f2f7;
  --color-background-tertiary: #e5e5ea;
  --color-background-info: #E6F1FB;
  --color-background-success: #EAF3DE;
  --color-background-warning: #FAEEDA;
  --color-background-danger: #FCEBEB;
  --color-text-primary: #1c1c1e;
  --color-text-secondary: #636366;
  --color-text-tertiary: #8e8e93;
  --color-text-info: #185FA5;
  --color-text-success: #3B6D11;
  --color-text-warning: #854F0B;
  --color-text-danger: #A32D2D;
  --color-border-primary: rgba(0,0,0,.4);
  --color-border-secondary: rgba(0,0,0,.3);
  --color-border-tertiary: rgba(0,0,0,.15);
  --color-border-info: #378ADD;
  --color-border-success: #639922;
  --color-border-warning: #BA7517;
  --color-border-danger: #E24B4A;
  --color-c-teal-600: #0F6E56;
  --color-gray-400: #888780;
  --font-sans: -apple-system, BlinkMacSystemFont, SF Pro Text, sans-serif;
  --font-serif: Georgia, Times New Roman, serif;
  --font-mono: SF Mono, Menlo, monospace;
  --border-radius-sm: 4px;
  --border-radius-md: 8px;
  --border-radius-lg: 12px;
  --border-radius-xl: 16px;
  --foreground: var(--color-text-primary);
  --muted: var(--color-text-secondary);
  --accent: var(--color-text-info);
  --border: var(--color-border-tertiary);
  --code-bg: var(--color-background-secondary);
}
.t { font-family: var(--font-sans); font-size: 14px; fill: var(--color-text-primary); }
.ts { font-family: var(--font-sans); font-size: 12px; fill: var(--color-text-secondary); }
.th { font-family: var(--font-sans); font-size: 14px; font-weight: 500; fill: var(--color-text-primary); }
.box { fill: var(--color-background-secondary); stroke: var(--color-border-tertiary); stroke-width: 1; rx: 6; }
.node { cursor: pointer; }
.node:hover .box { fill: var(--color-background-tertiary); }
.arr { stroke: var(--color-text-secondary); stroke-width: 1.5; fill: none; marker-end: url(#arrowhead); }
.leader { stroke: var(--color-border-tertiary); stroke-width: .5; stroke-dasharray: 4 2; fill: none; }

.c-purple { --node-bg:#EEEDFE; --node-border:#7F77DD; --node-text:#26215C; --node-text-sub:#534AB7; }
.c-teal { --node-bg:#E1F5EE; --node-border:#1D9E75; --node-text:#04342C; --node-text-sub:#0F6E56; }
.c-coral { --node-bg:#FAECE7; --node-border:#D85A30; --node-text:#4A1B0C; --node-text-sub:#9B3318; }
.c-pink { --node-bg:#FBEAF0; --node-border:#D4537E; --node-text:#4B1528; --node-text-sub:#9C2D56; }
.c-gray { --node-bg:#F1EFE8; --node-border:#888780; --node-text:#2C2C2A; --node-text-sub:#5C5C5A; }
.c-blue { --node-bg:#E6F1FB; --node-border:#378ADD; --node-text:#042C53; --node-text-sub:#1B5C99; }
.c-green { --node-bg:#EAF3DE; --node-border:#639922; --node-text:#173404; --node-text-sub:#3A6B10; }
.c-amber { --node-bg:#FAEEDA; --node-border:#BA7517; --node-text:#412402; --node-text-sub:#7A4A10; }
.c-red { --node-bg:#FCEBEB; --node-border:#E24B4A; --node-text:#501313; --node-text-sub:#9B2222; }
.c-purple .box,.c-teal .box,.c-coral .box,.c-pink .box,.c-gray .box,.c-blue .box,.c-green .box,.c-amber .box,.c-red .box { fill:var(--node-bg); stroke:var(--node-border); }
.c-purple .t,.c-purple .th,.c-teal .t,.c-teal .th,.c-coral .t,.c-coral .th,.c-pink .t,.c-pink .th,.c-gray .t,.c-gray .th,.c-blue .t,.c-blue .th,.c-green .t,.c-green .th,.c-amber .t,.c-amber .th,.c-red .t,.c-red .th { fill:var(--node-text); }
.c-purple .ts,.c-teal .ts,.c-coral .ts,.c-pink .ts,.c-gray .ts,.c-blue .ts,.c-green .ts,.c-amber .ts,.c-red .ts { fill:var(--node-text-sub); }
.c-purple rect,.c-purple circle,.c-purple ellipse,.c-teal rect,.c-teal circle,.c-teal ellipse,.c-coral rect,.c-coral circle,.c-coral ellipse,.c-pink rect,.c-pink circle,.c-pink ellipse,.c-gray rect,.c-gray circle,.c-gray ellipse,.c-blue rect,.c-blue circle,.c-blue ellipse,.c-green rect,.c-green circle,.c-green ellipse,.c-amber rect,.c-amber circle,.c-amber ellipse,.c-red rect,.c-red circle,.c-red ellipse { fill:var(--node-bg); stroke:var(--node-border); }
.c-purple text,.c-teal text,.c-coral text,.c-pink text,.c-gray text,.c-blue text,.c-green text,.c-amber text,.c-red text { fill:var(--node-text); }


html { color-scheme: light; }
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; background: var(--color-background-primary); overflow-x: hidden; }
body { color: var(--color-text-primary); font-family: var(--font-sans); }
#show-widget-root { width: 100%; min-height: 1px; }
#show-widget-root > svg { display: block; width: 100%; height: auto; }
</style>
<script>
(function () {
  'use strict';
  var pending = false;
  var generation = null;
  var lastHeight = 0;
  var lastViewportHeight = 0;
  var lastViewportWidth = 0;
  var lastContentHeight = 0;
  var scrollable = false;
  var boundedHeight = 0;
  function post(payload) {
    if (generation !== null) payload.generation = generation;
    if (window.ShowWidgetBridge && window.ShowWidgetBridge.postMessage) {
      window.ShowWidgetBridge.postMessage(JSON.stringify(payload));
    }
  }
  window.sendPrompt = function (text) {
    if (typeof text !== 'string') text = String(text || '');
    text = text.trim().slice(0, 500);
    if (text) post({type: 'prompt', text: text});
  };
  function reportSize() {
    pending = false;
    var root = document.getElementById('show-widget-root');
    if (!root) return;
    var rect = root.getBoundingClientRect();
    // Generated widgets often style body as a centered flex container or let
    // the first child's margin collapse through the root. Measuring only the
    // root's own height drops that leading document offset and clips the same
    // amount from the bottom of the inline WebView.
    var rootTop = Math.max(0, rect.top + window.scrollY);
    var height = Math.ceil(rootTop + Math.max(root.scrollHeight, rect.height));
    var viewportHeight = window.innerHeight;
    var viewportWidth = window.innerWidth;
    var becameScrollable = false;
    // A viewport-relative document can have no fitting height (100vh + a
    // margin, for example). Stop feeding that growth back into its viewport.
    // Preserve its layout and make the remaining content scrollable instead.
    if (false && !scrollable && lastViewportHeight > 0 &&
        viewportWidth === lastViewportWidth && viewportHeight === lastHeight &&
        viewportHeight > lastViewportHeight && height > viewportHeight &&
        height - lastContentHeight >= viewportHeight - lastViewportHeight) {
      scrollable = becameScrollable = true;
      boundedHeight = Math.min(lastHeight, 1600);
    }
    lastViewportHeight = viewportHeight;
    lastViewportWidth = viewportWidth;
    lastContentHeight = height;
    var reportedHeight = scrollable ? boundedHeight : height;
    if (reportedHeight > 0 && (reportedHeight !== lastHeight || becameScrollable)) {
      lastHeight = reportedHeight;
      post({type: 'size', height: reportedHeight, scrollable: scrollable});
    }
  }
  function scheduleSize() {
    if (pending) return;
    pending = true;
    requestAnimationFrame(reportSize);
  }
  window.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('show-widget-root');
    if (root && window.ResizeObserver) {
      var observer = new ResizeObserver(scheduleSize);
      observer.observe(root);
      observer.observe(document.body);
    }
    scheduleSize();
  });
  window.addEventListener('load', function () {
    scheduleSize();
    if (generation === null) return;
    Promise.resolve(document.fonts ? document.fonts.ready : null).then(function () {
      requestAnimationFrame(function () {
        reportSize();
        requestAnimationFrame(function () { post({type: 'ready'}); });
      });
    });
  });
  window.addEventListener('error', function (event) {
    post({type: 'error', message: String(event.message || 'Widget script failed')});
  });
})();
</script>
</head>
<body><div id="show-widget-root"><style>
  .bs-wrap{font-family:ui-sans-serif,system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--fg,#1f2328);max-width:760px;margin:0 auto;}
  .bs-title{font-size:15px;font-weight:600;margin:0 0 4px;}
  .bs-sub{font-size:12.5px;color:var(--muted,#6b7280);margin:0 0 18px;line-height:1.6;}
  .bs-row{display:grid;grid-template-columns:repeat(12,1fr);gap:6px;margin-bottom:26px;}
  .bs-cell{position:relative;aspect-ratio:1/1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    border-radius:8px;border:1px solid var(--line,#e5e7eb);background:var(--cell,#fafafa);transition:all .3s ease;}
  .bs-cell .v{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;}
  .bs-cell .i{font-size:9.5px;color:var(--muted,#9aa3af);margin-top:1px;font-variant-numeric:tabular-nums;}
  .bs-cell.out{opacity:.28;filter:grayscale(1);}
  .bs-cell.mid{background:var(--cur,#fef3c7);border-color:var(--curb,#f0b429);transform:translateY(-3px) scale(1.06);
    box-shadow:0 4px 12px rgba(240,180,41,.3);}
  .bs-cell.found{background:var(--ok,#dcfce7);border-color:var(--okb,#4ade80);transform:scale(1.1);
    box-shadow:0 4px 14px rgba(34,197,94,.35);}
  .bs-cell.fail{background:var(--bad,#fee2e2);border-color:var(--badb,#f87171);}
  .mk{position:absolute;font-size:9.5px;font-weight:600;letter-spacing:.3px;white-space:nowrap;}
  .mk-lo{top:-15px;left:50%;transform:translateX(-50%);color:var(--lo,#1a56c4);}
  .mk-hi{bottom:-15px;left:50%;transform:translateX(-50%);color:var(--hi,#c2410c);}
  .bs-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px;}
  .bs-btn{font:inherit;font-size:12.5px;padding:7px 14px;border-radius:8px;cursor:pointer;
    border:1px solid var(--btnb,#d0d7de);background:var(--btn,#fff);color:var(--fg,#1f2328);transition:.15s;}
  .bs-btn:hover{background:var(--btnh,#f6f8fa);}
  .bs-btn.primary{background:var(--acc,#1a56c4);border-color:var(--acc,#1a56c4);color:#fff;}
  .bs-btn:disabled{opacity:.45;cursor:default;}
  .bs-log{font-size:12.5px;line-height:1.7;color:var(--fg,#1f2328);min-height:44px;padding:9px 12px;
    border-radius:8px;background:var(--panel,#f7f8fa);border:1px solid var(--line,#e5e7eb);}
  .bs-log code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;
    background:var(--code,#eef1f5);padding:1px 5px;border-radius:4px;}
  .bs-log .res{font-weight:600;}
  .bs-log .res.y{color:var(--okfg,#15803d);}
  .bs-log .res.n{color:var(--badfg,#b91c1c);}
  .bs-stat{display:flex;gap:18px;font-size:12px;color:var(--muted,#6b7280);margin-top:10px;}
  .bs-stat b{color:var(--fg,#1f2328);font-variant-numeric:tabular-nums;}
</style>
<div class="bs-wrap">
  <p class="bs-title">二分查找：在 12 个有序数里找 23</p>
  <p class="bs-sub">每次只看中间那个数，比它小就往左，比它大就往右。每步砍掉一半候选。</p>
  <div class="bs-row" id="bsRow"></div>
  <div class="bs-bar">
    <button class="bs-btn primary" id="bsNext">下一步</button>
    <button class="bs-btn" id="bsAuto">自动播放</button>
    <button class="bs-btn" id="bsReset">重置</button>
    <button class="bs-btn" id="bsTarget">换个目标</button>
  </div>
  <div class="bs-log" id="bsLog">点击「下一步」开始</div>
  <div class="bs-stat">
    <span>区间 <b id="bsRange">[0, 11]</b></span>
    <span>候选数 <b id="bsLeft">12</b></span>
    <span>已比较 <b id="bsCnt">0</b></span>
    <span>线性查找需要 <b>12</b> 次，二分最多 <b>4</b> 次</span>
  </div>
</div>
<script>
(function(){
  var arr = [3,7,11,15,19,23,27,31,35,39,43,47];
  var targets = [23, 3, 47, 20, 31, 8, 43];
  var ti = 0, target = targets[0];
  var lo, hi, mid, cnt, done, timer = null;

  var row = document.getElementById('bsRow');
  var logEl = document.getElementById('bsLog');
  var rngEl = document.getElementById('bsRange');
  var leftEl = document.getElementById('bsLeft');
  var cntEl = document.getElementById('bsCnt');
  var nextBtn = document.getElementById('bsNext');
  var autoBtn = document.getElementById('bsAuto');
  var resetBtn = document.getElementById('bsReset');
  var tgtBtn = document.getElementById('bsTarget');

  function build(){
    row.innerHTML = '';
    for (var i = 0; i < arr.length; i++){
      var d = document.createElement('div');
      d.className = 'bs-cell';
      d.innerHTML = '<span class="v">' + arr[i] + '</span><span class="i">' + i + '</span>' +
                    '<span class="mk mk-lo">lo</span><span class="mk mk-hi">hi</span>';
      row.appendChild(d);
    }
    lo = 0; hi = arr.length - 1; mid = -1; cnt = 0; done = false;
    logEl.innerHTML = '目标值 <code>' + target + '</code>，初始区间 [0, 11]';
    nextBtn.disabled = false;
    if (timer){ clearInterval(timer); timer = null; autoBtn.textContent = '自动播放'; }
    render();
    document.getElementById('bsLeft').textContent = arr.length;
    cntEl.textContent = 0;
  }

  function render(){
    var cells = row.children;
    for (var i = 0; i < cells.length; i++){
      var c = cells[i];
      c.className = 'bs-cell';
      if (i < lo || i > hi) c.classList.add('out');
    }
    // 指针标记
    var loCell = cells[lo], hiCell = cells[hi];
    for (var k = 0; k < cells.length; k++){
      var mlo = cells[k].querySelector('.mk-lo'), mhi = cells[k].querySelector('.mk-hi');
      mlo.style.display = (lo <= hi && k === lo) ? 'block' : 'none';
      mhi.style.display = (lo <= hi && k === hi) ? 'block' : 'none';
      if (lo === hi && k === lo){ mlo.style.display = 'block'; mhi.style.display = 'none'; }
    }
    if (mid >= 0 && mid < cells.length && lo <= hi) cells[mid].classList.add('mid');
    rngEl.textContent = lo <= hi ? '[' + lo + ', ' + hi + ']' : '空';
    leftEl.textContent = Math.max(0, hi - lo + 1);
    cntEl.textContent = cnt;
  }

  function step(){
    if (done) return false;
    if (lo > hi){
      done = true;
      logEl.innerHTML = '<span class="res n">查找失败</span>：区间已空，' + target + ' 不在数组中。共比较 ' + cnt + ' 次。';
      nextBtn.disabled = true;
      if (timer){ clearInterval(timer); timer = null; autoBtn.textContent = '自动播放'; }
      render();
      return false;
    }
    mid = (lo + hi) >> 1;      // 等价于 lo + (hi - lo) / 2，避免溢出
    cnt++;
    var v = arr[mid];
    var cells = row.children;
    if (v === target){
      for (var k = 0; k < cells.length; k++) cells[k].style.display = '';
      mid = mid; done = true;
      render();
      cells[mid].classList.add('found');
      logEl.innerHTML = '<code>arr[' + mid + '] = ' + v + ' == ' + target + '</code>　<span class="res y">找到了</span>，位置 ' + mid + '，共比较 ' + cnt + ' 次。';
      nextBtn.disabled = true;
      if (timer){ clearInterval(timer); timer = null; autoBtn.textContent = '自动播放'; }
      return false;
    }
    if (v < target){
      logEl.innerHTML = '<code>arr[' + mid + '] = ' + v + ' &lt; ' + target + '</code>　目标在右半边，<code>lo = mid + 1 = ' + (mid+1) + '</code>';
      lo = mid + 1;
    } else {
      logEl.innerHTML = '<code>arr[' + mid + '] = ' + v + ' &gt; ' + target + '</code>　目标在左半边，<code>hi = mid − 1 = ' + (mid-1) + '</code>';
      hi = mid - 1;
    }
    render();
    return true;
  }

  nextBtn.addEventListener('click', step);
  resetBtn.addEventListener('click', build);
  tgtBtn.addEventListener('click', function(){
    if (timer){ clearInterval(timer); timer = null; }
    ti = (ti + 1) % targets.length;
    target = targets[ti];
    build();
  });
  autoBtn.addEventListener('click', function(){
    if (timer){ clearInterval(timer); timer = null; autoBtn.textContent = '自动播放'; return; }
    if (done) return;
    autoBtn.textContent = '暂停';
    timer = setInterval(function(){ if (!step()){ clearInterval(timer); timer = null; autoBtn.textContent = '自动播放'; } }, 900);
  });

  build();
})();
</script></div></body>
</html>
